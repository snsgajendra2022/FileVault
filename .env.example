# Copy to `.env` for local development. Never commit real secrets.

# Required: base URL for your API (same as today)
REACT_APP_API_URL=

# OpenClaw assistant (optional UI at /studio/openclaw when enabled)
# Gateway credentials belong on the server only — the SPA calls your API routes.
REACT_APP_OPENCLAW_ENABLED=false
REACT_APP_OPENCLAW_CHAT_PATH=/api/openclaw/chat
REACT_APP_OPENCLAW_VOICE_PATH=/api/openclaw/voice
REACT_APP_OPENCLAW_IMAGE_PATH=/api/openclaw/image
REACT_APP_OPENCLAW_SESSION_PATH=/api/openclaw/session
# Local dev: CRA + server/openclaw-dev-server.js (npm start). Omit in production builds.
REACT_APP_OPENCLAW_DEV_URL=http://192.168.1.58:9093
OPENCLAW_DEV_PORT=9093

# --- Real assistant (Node dev server only — never REACT_APP_*) ---
#
# Option A — HTTP bridge (OpenClaw / your API)
# REACT_APP_OPENCLAW_DEV_URL must stay http://192.168.1.58:9093 for local npm start; that is NOT the bridge URL.
# OPENCLAW_BRIDGE_URL = full URL of a service that accepts POST JSON (see backend.md). Never http://192.168.1.58:9093.
#
# OpenClaw CLI in this repo: dependency `openclaw` (real versions are calver, e.g. 2026.4.9 — NOT npm’s bogus 0.0.1 placeholder).
# Requires Node.js >= 22.12 (check: node -v). Then:
#   npm run openclaw:onboard
#   npm run openclaw -- config get gateway.auth.token
# (Same as npx openclaw … from the project root.)
# Gateway token (same value many bridges use as Bearer auth):
#   npm run openclaw -- config get gateway.auth.token
# Or generate: npm run openclaw -- doctor --generate-gateway-token
# OpenClaw also supports env OPENCLAW_GATEWAY_TOKEN in ~/.openclaw — copy the token string into filevault only for OPENCLAW_BRIDGE_TOKEN if your bridge checks Authorization: Bearer …
#
# OPENCLAW_BRIDGE_URL=http://127.0.0.1:YOUR_PORT/your-openclaw-bridge
# OPENCLAW_BRIDGE_TOKEN=paste-gateway-token-here-if-bridge-requires-bearer

# Option B: OpenAI directly (real chat + vision on image upload; not OpenClaw)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_BASE=https://api.openai.com/v1
#  REACT_APP_API_URL=https://filevault.mytiny.us
#  ===========================================Loacl live url============================================================
#  REACT_APP_API_URL=http://10.168.89.30:9090

#  REACT_APP_API_URL=http://192.168.1.40:9090

# REACT_APP_API_URL=https://backendstudio.mytiny.us
 REACT_APP_API_URL=https://backendstudio.mytiny.us
#  REACT_APP_API_URL=http://192.168.1.40:9090
REACT_APP_BLOCK_INSPECT = true

# OpenClaw — browser calls these on REACT_APP_API_URL; Gateway credentials only on your server
REACT_APP_OPENCLAW_ENABLED=true
REACT_APP_OPENCLAW_CHAT_PATH=/api/openclaw/chat
REACT_APP_OPENCLAW_VOICE_PATH=/api/openclaw/voice
REACT_APP_OPENCLAW_IMAGE_PATH=/api/openclaw/image
REACT_APP_OPENCLAW_SESSION_PATH=/api/openclaw/session
REACT_APP_OPENCLAW_DEV_URL=http://192.168.1.58:9093
# Do not set OPENCLAW_BRIDGE_URL to this dev server (9093). Use a separate HTTP bridge that accepts POST JSON (see backend.md).
# After `openclaw onboard`, read the gateway token with: openclaw config get gateway.auth.token
# Put that same secret in OPENCLAW_BRIDGE_TOKEN only if your bridge authorizes with Bearer <token>.
OPENCLAW_BRIDGE_URL=http://192.168.1.58:9093
OPENCLAW_BRIDGE_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-5.2
OPENAI_API_BASE=https://api.openai.com/v1
OPENCLAW_DEV_PORT=9093
#  ===========================================Start live url============================================================
#  ===========================================Start live url============================================================
#  REACT_APP_API_URL=https://filevault.mytiny.us/
#  
#  ===========================================End live url============================================================