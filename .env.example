# Copy to `.env` for local development. Never commit real secrets.

# Main Filevault API (React app + OM tools on dev server)
REACT_APP_API_URL=https://backendstudio.mytiny.us

# FaceSync (optional)
# REACT_APP_FACESYNC_API_URL=http://127.0.0.1:8000

REACT_APP_BLOCK_INSPECT=true

# OpenClaw / OM assistant UI
REACT_APP_OPENCLAW_ENABLED=true
REACT_APP_OPENCLAW_CHAT_PATH=/api/openclaw/chat
REACT_APP_OPENCLAW_VOICE_PATH=/api/openclaw/voice
REACT_APP_OPENCLAW_IMAGE_PATH=/api/openclaw/image
REACT_APP_OPENCLAW_SESSION_PATH=/api/openclaw/session
# Dev: chat/voice/image go here (npm start runs server/openclaw-dev-server.js)
REACT_APP_OPENCLAW_DEV_URL=http://127.0.0.1:9093
OPENCLAW_DEV_PORT=9093

# --- Node dev server only (never REACT_APP_*) ---

# Filevault API base for OM tools (defaults to REACT_APP_API_URL)
FILEVAULT_API_URL=
OM_TOOLS_ENABLED=true

# Option A: external bridge to OpenClaw Gateway / Java (NOT port 9093)
# OPENCLAW_BRIDGE_URL=http://127.0.0.1:8080/internal/openclaw-bridge
# OPENCLAW_BRIDGE_TOKEN=
# npm run openclaw:onboard
# npm run openclaw -- config get gateway.auth.token

# Option B: direct LLM in dev (OpenRouter/OpenAI)
# OPENAI_API_KEY=
# OPENAI_MODEL=openai/gpt-4o-mini
# OPENAI_API_BASE=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=http://localhost:3000

# WhatsApp: UI uses /api/whatsapp (proxied to 9093 in dev — see src/setupProxy.js)
# Production: implement on REACT_APP_API_URL — docs/BACKEND-OM-ASSISTANT.md
# Real link: npm run openclaw:whatsapp:login
